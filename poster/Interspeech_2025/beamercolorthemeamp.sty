% Gemini theme
% https://github.com/anishathalye/gemini

% ====================
% Definitions
% ====================

%\definecolor{lightgray}{RGB}{245, 246, 250}
%\definecolor{blue}{RGB}{64, 115, 158}
%\definecolor{darkblue}{RGB}{39, 60, 117}
\definecolor{lightgray}{HTML}{D3E398}
\definecolor{darkblue}{HTML}{2D728F}
\definecolor{blue}{HTML}{8DCCC1}
%\definecolor{yellow}{HTML}{F4F0E6}
\definecolor{yellow}{HTML}{FFF5C2}
%\definecolor{orange}{HTML}{F49E4C}
\definecolor{orange}{HTML}{EC6E45}
\definecolor{red}{HTML}{84271E}
\definecolor{titledark}{HTML}{163D4E}

% ====================
% Theme
% ====================

% Basic colors
\setbeamercolor{palette primary}{fg=black,bg=white}
\setbeamercolor{palette secondary}{fg=black,bg=white}
\setbeamercolor{palette tertiary}{bg=black,fg=white}
\setbeamercolor{palette quaternary}{fg=black,bg=white}
\setbeamercolor{structure}{fg=darkblue}

% Headline
\setbeamercolor{headline}{bg=lightgray,fg=titledark}
\setbeamercolor{headline rule}{bg=orange}

% Block
\setbeamercolor{block title}{bg=lightgray,fg=titledark}
\setbeamercolor{block separator}{bg=orange}
\setbeamercolor{block body}{fg=black,bg=white}

% Alert Block
\setbeamercolor{block alerted title}{bg=lightgray,fg=titledark}
\setbeamercolor{block alerted separator}{bg=orange}
\setbeamercolor{block alerted body}{fg=black,bg=lightgray}

% Heading
\setbeamercolor{heading}{bg=red}
\setbeamercolor{heading}{fg=darkblue}

% Itemize
\setbeamercolor{item}{fg=darkblue}

% Bibliography
\setbeamercolor{bibliography item}{fg=black}
\setbeamercolor{bibliography entry author}{fg=black}
\setbeamercolor{bibliography entry title}{fg=black}
\setbeamercolor{bibliography entry location}{fg=black}
\setbeamercolor{bibliography entry note}{fg=black}